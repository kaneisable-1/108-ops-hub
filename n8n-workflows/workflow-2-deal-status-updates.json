{
  "name": "GHL Deal Status Updates (Webhook → Supabase → SMS)",
  "nodes": [
    {
      "id": "uuid-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-deal-events",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "ghl-deal-events"
    },
    {
      "id": "uuid-2",
      "name": "Parse GHL Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    eventType: body.event || body.type || body.action || 'unknown',\n    contactId: body.contact_id || body.contactId || body.contact?.id || null,\n    contactName: body.contact_name || body.contactName || body.contact?.name || body.contact?.firstName || null,\n    contactEmail: body.contact_email || body.contact?.email || null,\n    contactPhone: body.contact_phone || body.contact?.phone || null,\n    documentId: body.document_id || body.documentId || null,\n    paymentId: body.payment_id || body.paymentId || null,\n    paymentStatus: body.payment_status || body.status || null,\n    amount: body.amount || null,\n    rawEvent: body\n  }\n}];"
      }
    },
    {
      "id": "uuid-3",
      "name": "Lookup Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/deals?ghl_contact_id=eq.{{ $json.contactId }}&status=not.in.(complete,canceled,expired)&order=created_at.desc&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "uuid-4",
      "name": "Check Deal Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const deals = $input.first().json;\nconst prev = $('Parse GHL Event').first().json;\n\nif (!Array.isArray(deals) && !deals.id) {\n  throw new Error('No active deal found for contact: ' + prev.contactId);\n}\n\nconst deal = Array.isArray(deals) ? deals[0] : deals;\nif (!deal || !deal.id) {\n  throw new Error('No active deal found for contact: ' + prev.contactId);\n}\n\nreturn [{\n  json: {\n    dealId: deal.id,\n    leadId: deal.lead_id,\n    packageCode: deal.package_code,\n    athleteName: deal.athlete_name || prev.contactName || 'Unknown',\n    athleteEmail: deal.athlete_email || prev.contactEmail || null,\n    athletePhone: deal.athlete_phone || prev.contactPhone || null,\n    staffPhone: deal.created_by_phone || '+18653814600',\n    packageName: deal.package_name || deal.package_code || 'package',\n    eventType: prev.eventType,\n    contactId: prev.contactId,\n    paymentId: prev.paymentId,\n    amount: prev.amount\n  }\n}];"
      }
    },
    {
      "id": "uuid-5",
      "name": "Switch Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1250, 300],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "contract_signed",
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "contract_signed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "payment_complete",
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment_complete",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment_received",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment.completed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "payment_failed",
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment_failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment.failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "delivery_failed",
              "conditions": {
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "delivery_failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "document.bounced",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "email.bounced",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
