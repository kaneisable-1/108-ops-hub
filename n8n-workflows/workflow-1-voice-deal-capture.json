    {
      "id": "uuid-10",
      "name": "Format Status Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const routeData = $('Route Message').first().json;\nconst deals = $('Lookup Active Deals for Status').all().map(i => i.json);\nconst dealList = Array.isArray(deals[0]) ? deals[0] : deals;\n\nlet msg = '';\nif (!dealList.length || !dealList[0]?.id) {\n  msg = 'No active deals found.';\n} else {\n  msg = `Active Deals (${dealList.length}):\\n\\n`;\n  dealList.forEach((d, i) => {\n    const price = d.price_cents ? `$${(d.price_cents / 100).toFixed(0)}` : 'TBD';\n    msg += `${i + 1}. ${d.athlete_name} - ${d.package}\\n   ${price}/${d.billing_frequency} | Status: ${d.status}\\n\\n`;\n  });\n}\n\nreturn [{ json: { ...routeData, statusMessage: msg } }];"
      }
