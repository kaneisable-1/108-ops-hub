        "jsCode": "const d = $json.deal;\nconst staff = $json;\nreturn [{\n  json: {\n    dealBody: {\n      athlete_name: d.athlete_name,\n      athlete_phone: d.athlete_phone || null,\n      athlete_email: d.athlete_email || null,\n      athlete_level: d.athlete_level || null,\n      athlete_age: d.athlete_age || null,\n      sport: d.sport || 'baseball',\n      skill_focus: d.skill_focus || null,\n      package: d.package,\n      billing_frequency: d.billing_frequency || 'one_time',\n      price_cents: d.price_cents,\n      status: 'pending_confirmation',\n      staff_id: staff.staffId,\n      raw_transcript: staff.transcript,\n      parsed_data: JSON.stringify(d),\n      ai_confidence: d.confidence,\n      is_deal: true,\n      confirmation_sent_at: new Date().toISOString(),\n      preferred_start: d.preferred_start || null,\n      preferred_schedule: d.preferred_schedule || null,\n      notes: d.notes || null\n    },\n    deal: d,\n    staffPhoneE164: staff.staffPhoneE164,\n    staffId: staff.staffId,\n    staffName: staff.staffName\n  }\n}];"
