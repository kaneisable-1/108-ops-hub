    {
      "id": "uuid-3",
      "name": "Parse Twilio Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body;\nconst items = [{\n  json: {\n    from: body.From || body.from || '',\n    staffPhone: (body.From || body.from || '').replace(/^\\+1/, '').replace(/\\D/g, ''),\n    staffPhoneE164: body.From || body.from || '',\n    messageBody: (body.Body || body.body || '').trim(),\n    numMedia: parseInt(body.NumMedia || body.numMedia || '0', 10),\n    mediaUrl: body.MediaUrl0 || body.mediaUrl0 || null,\n    mediaType: body.MediaContentType0 || body.mediaContentType0 || null,\n    messageSid: body.MessageSid || body.messageSid || null\n  }\n}];\nreturn items;"
      }
    },
    {
      "id": "uuid-4",
      "name": "Staff Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/users?or=(phone.eq.{{ $json.staffPhoneE164 }},phone.eq.{{ $json.staffPhone }})&select=id,name,role,phone",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "uuid-5",
      "name": "Route Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const staffResult = $('Staff Lookup').first().json;\nconst parsed = $('Parse Twilio Payload').first().json;\nconst staffArr = Array.isArray(staffResult) ? staffResult : (staffResult?.id ? [staffResult] : []);\n\nif (!staffArr.length || !staffArr[0]?.id) {\n  return [{ json: { ...parsed, route: 'unknown_sender', staffId: null, staffName: null } }];\n}\n\nconst staff = staffArr[0];\nconst msgLower = (parsed.messageBody || '').toLowerCase().trim();\n\nlet route = 'new_deal';\nif (msgLower === 'help') route = 'command_help';\nelse if (msgLower === 'status') route = 'command_status';\nelse if (['yes','yep','ya','yeah','sure','send it','confirm','approved','do it','go','go ahead'].some(k => msgLower === k || msgLower.startsWith(k + ' '))) route = 'reply_confirm';\nelse if (msgLower.startsWith('edit') || msgLower.startsWith('change')) route = 'reply_edit';\nelse if (['cancel','no','nope','nah','stop','nevermind','never mind'].some(k => msgLower === k || msgLower.startsWith(k + ' '))) route = 'reply_cancel';\nelse if (parsed.numMedia === 0 && parsed.messageBody.length < 20 && !parsed.messageBody.includes(' ')) route = 'reply_unclear';\n\nreturn [{ json: { ...parsed, route, staffId: staff.id, staffName: staff.name, staffRole: staff.role } }];"
      }
    },
